DATABASE_URL=postgresql://mindforge:mindforge_dev_pw@db:5432/mindforge
JWT_SECRET=change_this_in_production_use_a_long_random_string_at_least_32_chars
JWT_EXPIRY_MINUTES=60
INTAKE_TOKEN_TTL_HOURS=72
ENVIRONMENT=development
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_A_REAL_FERNET_KEY
# Public base URL for scannable intake links (deployed or LAN URL, NOT localhost)
FRONTEND_PUBLIC_URL=https://app.mindforge.example
